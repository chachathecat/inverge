# Core AI Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REVIEW_OS_OPENAI_MODEL=gpt-4.1-mini
INVERGE_SECOND_EXAM_AI_PROVIDER=mock
INVERGE_SECOND_EXAM_AI_TIMEOUT_MS=3500

# Supabase
# Real auth/session requires:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_ANON_KEY
# Real user-level Postgres persistence additionally requires:
# - SUPABASE_SERVICE_ROLE_KEY
#
# Behavior summary:
# - all three set: real auth/session + real user-level persistence
# - URL + anon only: real auth/session, but server persistence is unavailable
# - values missing: demo-mode auth/session for local development only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Closed alpha access
# Comma-separated allowlist. In production, only these emails can enter /app.
ALPHA_INVITE_EMAILS=
# Optional admin allowlist for /admin/alpha
ALPHA_ADMIN_EMAILS=

# Owner-only Universal Appraisal Practice Study Loop v0
# Disabled unless the server-only flag is exactly "true" and the authenticated
# email is in ALPHA_ADMIN_EMAILS. The model override is feature-local.
OWNER_ALPHA_UNIVERSAL_PRACTICE_ENABLED=false
OWNER_ALPHA_PRACTICE_MODEL=

# App
NEXT_PUBLIC_APP_NAME=Inverge

# M418 Web Push
# Generate local development values with:
# npm.cmd run generate:vapid
# Keep NEXT_PUBLIC_VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY as a matching pair.
# VAPID_PRIVATE_KEY, SUPABASE_SERVICE_ROLE_KEY, and CRON_SECRET are server-only.
# Changing VAPID keys invalidates or requires replacing existing push subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# C2R-C-P Owner-only synthetic Practice trusted-repair vertical.
# Keep disabled unless the authenticated email is explicitly present in both
# ALPHA_ADMIN_EMAILS and this feature-local Owner allowlist.
WCV_C2R_C_P_PRACTICE_ENABLED=false
WCV_C2R_C_P_OWNER_EMAILS=

# C2R-C-T Owner-only synthetic Theory trusted-repair vertical.
# Independently disabled unless the authenticated email is explicitly present
# in both ALPHA_ADMIN_EMAILS and this Theory-local Owner allowlist.
WCV_C2R_C_T_THEORY_ENABLED=false
WCV_C2R_C_T_OWNER_EMAILS=
WCV_C2R_C_L_LAW_ENABLED=false
WCV_C2R_C_L_OWNER_EMAILS=
# Server-only unpadded base64url encoding of exactly 32 random bytes.
# APP-1 fails closed without it; do not prefix with NEXT_PUBLIC_.
APP1_VERIFICATION_SIGNING_SECRET=

# First-stage private learner flow: server only, disabled and empty by default.
INVERGE_OWNER_FIRST_STAGE_KERNEL_ENABLED=false
# Reviewed economics Bank-first: independently OFF; no Vercel/Production use.
# Requires separately authorized local schema/content installation; no provider fallback.
INVERGE_OWNER_REVIEWED_BANK_ENABLED=false
INVERGE_OWNER_FIRST_STAGE_EMAILS=
# Absolute private file path. An empty approved digest registry still denies stock.
# Never point to raw review candidates or install synthetic test approvals.
INVERGE_OWNER_ECONOMICS_CONTENT_PATH=
# Accounting uses its own exact reviewed snapshot; installed approvals remain empty.
INVERGE_OWNER_ACCOUNTING_CONTENT_PATH=
# Declarations only; all three installed approval lists remain empty.
# Law routes support reviewed historical exam-date snapshots, not current-law claims.
INVERGE_OWNER_CIVIL_LAW_CONTENT_PATH=
INVERGE_OWNER_REAL_ESTATE_PRINCIPLES_CONTENT_PATH=
INVERGE_OWNER_APPRAISER_RELATED_LAW_CONTENT_PATH=
